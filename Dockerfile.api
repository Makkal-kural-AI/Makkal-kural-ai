FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-api.txt

ARG WHISPER_MODEL=tiny
RUN python -c "import whisper; whisper.load_model('${WHISPER_MODEL}', device='cpu')"

COPY classifier.py voice_ai.py device_api.py ./

# One worker: Whisper is heavy, so share a single loaded model across threads.
CMD ["sh", "-c", "gunicorn device_api:app --bind 0.0.0.0:${PORT:-8080} --workers 1 --threads 2 --timeout 180"]
